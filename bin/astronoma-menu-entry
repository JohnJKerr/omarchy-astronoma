#!/usr/bin/env python3
"""Add (or remove) Astronoma's row in the Omarchy menu.

With the bar widget on its default `unread` visibility the rocket stands
down once an update has been read, which leaves no obvious way back in.
This puts a permanent row under Update, so the flight log is always
reachable without memorising an IPC call or spending a keybinding.

Edits ~/.config/omarchy/extensions/omarchy-menu.jsonc, which is JSONC and
usually full of the user's own comments, so the row is spliced in as text
rather than round-tripped through a JSON parser.
"""

import os
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "helper"))

from astronoma import paths  # noqa: E402

KEY = "update.astronoma"
MAX_MENU_BYTES = 2 * 1024 * 1024
# The rocket, written as an escape rather than a literal: this row travels
# through shells and editors on its way into a JSONC file, and a bare
# multi-byte glyph does not reliably survive that trip.
ICON = "\uf135"
ROW = (
    '  "%s": {"icon":"%s","label":"Changelog",'
    '"description":"Astronoma - what the last Omarchy update changed",'
    '"action":"omarchy-shell shell toggle io.github.johnjkerr.astronoma \'{}\'"},\n'
    % (KEY, ICON)
)


class MenuSyntaxError(ValueError):
    pass


def _scan(text: str) -> tuple[list[tuple[str, str, int, int, int]], int]:
    """Tokenize enough JSONC to edit top-level properties without touching strings."""
    tokens = []
    stack = []
    index = 0
    root_close = -1
    while index < len(text):
        char = text[index]
        if char.isspace():
            index += 1
            continue
        if text.startswith("//", index):
            end = text.find("\n", index)
            index = len(text) if end < 0 else end
            continue
        if text.startswith("/*", index):
            end = text.find("*/", index + 2)
            if end < 0:
                raise MenuSyntaxError("unterminated block comment")
            index = end + 2
            continue
        depth = len(stack)
        if char == '"':
            end = index + 1
            escaped = False
            while end < len(text):
                current = text[end]
                if current == '"' and not escaped:
                    end += 1
                    break
                if current in "\r\n" and not escaped:
                    raise MenuSyntaxError("newline in string")
                if current == "\\" and not escaped:
                    escaped = True
                else:
                    escaped = False
                end += 1
            else:
                raise MenuSyntaxError("unterminated string")
            try:
                value = json.loads(text[index:end])
            except json.JSONDecodeError as error:
                raise MenuSyntaxError("invalid string") from error
            tokens.append(("string", value, index, end, depth))
            index = end
            continue
        if char in "{[":
            tokens.append((char, char, index, index + 1, depth))
            stack.append(char)
        elif char in "}]":
            expected = "{" if char == "}" else "["
            if not stack or stack[-1] != expected:
                raise MenuSyntaxError("unbalanced container")
            if len(stack) == 1 and char == "}":
                root_close = index
            tokens.append((char, char, index, index + 1, depth))
            stack.pop()
        elif char in ":,":
            tokens.append((char, char, index, index + 1, depth))
        else:
            end = index + 1
            while end < len(text) and not text[end].isspace() and text[end] not in '{}[],:"/':
                end += 1
            tokens.append(("atom", text[index:end], index, end, depth))
            index = end
            continue
        index += 1
    if stack or not tokens or tokens[0][0] != "{" or root_close < 0:
        raise MenuSyntaxError("menu root is not a complete object")
    _validate_tokens(tokens)
    return tokens, root_close


def _validate_tokens(tokens) -> None:
    """Validate the JSON grammar, with comments removed and trailing commas allowed."""
    def value(position):
        if position >= len(tokens):
            raise MenuSyntaxError("missing value")
        kind = tokens[position][0]
        if kind == "string":
            return position + 1
        if kind == "atom":
            try:
                parsed = json.loads(tokens[position][1])
            except json.JSONDecodeError as error:
                raise MenuSyntaxError("invalid scalar") from error
            if isinstance(parsed, (dict, list, str)):
                raise MenuSyntaxError("invalid scalar")
            return position + 1
        if kind == "[":
            position += 1
            if position < len(tokens) and tokens[position][0] == "]":
                return position + 1
            while True:
                position = value(position)
                if position >= len(tokens):
                    raise MenuSyntaxError("unterminated array")
                if tokens[position][0] == "]":
                    return position + 1
                if tokens[position][0] != ",":
                    raise MenuSyntaxError("missing array comma")
                position += 1
                if position < len(tokens) and tokens[position][0] == "]":
                    return position + 1
        if kind == "{":
            position += 1
            if position < len(tokens) and tokens[position][0] == "}":
                return position + 1
            while True:
                if position >= len(tokens) or tokens[position][0] != "string":
                    raise MenuSyntaxError("object key is not a string")
                position += 1
                if position >= len(tokens) or tokens[position][0] != ":":
                    raise MenuSyntaxError("object key has no colon")
                position = value(position + 1)
                if position >= len(tokens):
                    raise MenuSyntaxError("unterminated object")
                if tokens[position][0] == "}":
                    return position + 1
                if tokens[position][0] != ",":
                    raise MenuSyntaxError("missing object comma")
                position += 1
                if position < len(tokens) and tokens[position][0] == "}":
                    return position + 1
        raise MenuSyntaxError("unexpected token")

    if value(0) != len(tokens):
        raise MenuSyntaxError("content follows the root object")


def _properties(text: str):
    tokens, root_close = _scan(text)
    properties = []
    for position, token in enumerate(tokens):
        kind, key, start, _end, depth = token
        if kind != "string" or depth != 1:
            continue
        if position + 1 >= len(tokens) or tokens[position + 1][0] != ":":
            continue
        if position == 0 or tokens[position - 1][0] not in ("{", ","):
            continue
        delimiter = None
        for candidate in tokens[position + 2:]:
            if candidate[4] == 1 and candidate[0] in (",", "}"):
                delimiter = candidate
                break
        if delimiter is None:
            raise MenuSyntaxError("property has no end")
        line_start = text.rfind("\n", 0, start) + 1
        property_start = line_start if text[line_start:start].strip() == "" else start
        value_end = delimiter[2]
        while value_end > start and text[value_end - 1].isspace():
            value_end -= 1
        properties.append({
            "key": key,
            "start": property_start,
            "value_end": value_end,
            "comma_end": delimiter[3] if delimiter[0] == "," else None,
        })
    return properties, root_close


def _replace_span(text: str, item: dict, replacement: str) -> str:
    end = item["comma_end"] or item["value_end"]
    if end < len(text) and text[end:end + 1] == "\n":
        end += 1
    return text[:item["start"]] + replacement + text[end:]


def target() -> Path:
    base = os.environ.get("XDG_CONFIG_HOME") or str(Path.home() / ".config")
    return Path(base) / "omarchy" / "extensions" / "omarchy-menu.jsonc"


def _load(path: Path) -> tuple[str, int]:
    try:
        raw, mode = paths.read_user_config(path, MAX_MENU_BYTES)
    except FileNotFoundError:
        return "{\n}\n", 0o644
    try:
        return raw.decode("utf-8"), mode
    except UnicodeError as error:
        raise MenuSyntaxError("menu file is not UTF-8") from error


def _store(path: Path, text: str, mode: int) -> None:
    encoded = text.encode("utf-8")
    if len(encoded) > MAX_MENU_BYTES:
        raise MenuSyntaxError("updated menu exceeds the byte limit")
    paths.atomic_bytes_write(path, encoded, private=False, mode=mode)


def add(path: Path) -> str:
    try:
        text, mode = _load(path)
        properties, closing = _properties(text)
    except (OSError, ValueError, MenuSyntaxError):
        return "could not parse the menu file; left it alone"
    existing = next((item for item in properties if item["key"] == KEY), None)
    if existing:
        # Rewrite in place rather than skipping, so a reinstall picks up a
        # changed label or action instead of leaving the old row behind.
        updated = _replace_span(text, existing, ROW)
        if updated == text:
            return "already present"
        try:
            _store(path, updated, mode)
        except (OSError, ValueError, MenuSyntaxError):
            return "could not update the menu file; left it alone"
        return "updated"
    # Splice before the final closing brace so surrounding comments survive.
    prefix = text[:closing]
    if properties and properties[-1]["comma_end"] is None:
        comma_at = properties[-1]["value_end"]
        prefix = prefix[:comma_at] + "," + prefix[comma_at:]
    updated = prefix + ROW + text[closing:]
    try:
        _store(path, updated, mode)
    except (OSError, ValueError, MenuSyntaxError):
        return "could not update the menu file; left it alone"
    return "added"


def remove(path: Path) -> str:
    try:
        text, mode = _load(path)
    except FileNotFoundError:
        return "nothing to remove"
    except (OSError, ValueError, MenuSyntaxError):
        return "could not parse the menu file; left it alone"
    try:
        properties, _closing = _properties(text)
    except MenuSyntaxError:
        return "could not parse the menu file; left it alone"
    existing = next((item for item in properties if item["key"] == KEY), None)
    if not existing:
        return "nothing to remove"
    updated = _replace_span(text, existing, "")
    # We add Astronoma last. If its removal exposes the separator that add()
    # introduced on the preceding property, restore the conventional form.
    was_last = existing is properties[-1]
    remaining, _closing = _properties(updated)
    if was_last and remaining and remaining[-1]["comma_end"] is not None:
        comma = remaining[-1]["comma_end"] - 1
        updated = updated[:comma] + updated[comma + 1:]
    try:
        _store(path, updated, mode)
    except (OSError, ValueError, MenuSyntaxError):
        return "could not update the menu file; left it alone"
    return "removed"


def main(argv) -> int:
    path = target()
    action = argv[1] if len(argv) > 1 else "add"
    if action not in ("add", "remove"):
        print("usage: astronoma-menu-entry [add|remove]", file=sys.stderr)
        return 2
    result = add(path) if action == "add" else remove(path)
    print(f"{result}: {path}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
