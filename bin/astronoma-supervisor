#!/usr/bin/env python3
"""Bound the helper process before its output reaches Quickshell."""

import os
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "helper"))

from astronoma.process import run_bounded  # noqa: E402


def main() -> int:
    timeout = 190 if "summarise" in sys.argv[1:] else 30
    try:
        code, stdout, stderr = run_bounded(
            [os.path.join(ROOT, "bin", "astronoma"), *sys.argv[1:]], os.getcwd(),
            timeout=timeout, stdout_limit=16 * 1024 * 1024,
            stderr_limit=64 * 1024,
        )
    except subprocess.TimeoutExpired:
        sys.stderr.write("Astronoma helper timed out\n")
        return 124
    except ValueError:
        sys.stderr.write("Astronoma helper returned too much output\n")
        return 125
    sys.stdout.buffer.write(stdout)
    sys.stderr.buffer.write(stderr)
    return code


if __name__ == "__main__":
    sys.exit(main())
