#!/usr/bin/env python3
"""Route the close shortcut to Astronoma before the active application."""
import subprocess
import sys


def main():
    try:
        for target in ("astronoma", "astronoma.bar"):
            result = subprocess.run(
                ["omarchy-shell", target, "closeIfOpen"],
                capture_output=True, text=True, timeout=2, check=True,
            )
            response = result.stdout.strip()
            if response == "closed":
                return 0
            if response != "inactive":
                raise ValueError("unexpected close response")
        return subprocess.run(
            ["hyprctl", "dispatch", "hl.dsp.window.close()"], timeout=2,
        ).returncode
    except (OSError, subprocess.SubprocessError, ValueError) as error:
        print(f"Could not route close shortcut: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
